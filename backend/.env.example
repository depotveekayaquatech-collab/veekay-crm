# Copy to backend/.env for local development. Never commit the real .env.

ENVIRONMENT=development
DEBUG=true

# Local Postgres. On Render this is injected from the managed database.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/veekayCRM

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-local-dev

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# JSON array of allowed browser origins (the frontend URL).
CORS_ORIGINS=["http://localhost:5173"]

# ---- Store sync from Google Sheets ----
# Each sheet must be shared as "Anyone with the link - Viewer" (or Published to web).
# Format: ["<partner_slug>=<spreadsheet_id>:<gid>", ...]
STORE_SYNC_SHEETS=["blinkit=SPREADSHEET_ID:0","zepto=SPREADSHEET_ID:0"]
STORE_SYNC_ENABLED=true
STORE_SYNC_HOUR=10
STORE_SYNC_MINUTE=0
STORE_SYNC_TIMEZONE=Asia/Kolkata

# ---- Order counts from Google Sheets ----
# Same sheet-sharing rule and format as above, but a platform may be listed several times (one per month tab).
# Layout: one row per store, one column per date (Outlet ID | Outlet Name | 2026-10-01 | 2026-10-02 ...).
# Runs right after the daily store sync; admins can also press "Sync from Sheet" on the Orders page.
ORDER_SYNC_SHEETS=["blinkit=SPREADSHEET_ID:0","zepto=SPREADSHEET_ID:0"]
ORDER_SYNC_ENABLED=true
# false = days that already have a different count are kept; true = the sheet replaces them.
ORDER_SYNC_OVERWRITE=false

# ---- Test reports (water tests, valid for six months) ----
# Platforms that accept test reports (Blinkit is off for now) and how many days before expiry the alert starts.
# TEST_REPORT_PLATFORMS=["zepto"]
# TEST_REPORT_ALERT_DAYS=30

# ---- Tickets from a Google Apps Script ----
# Shared secret the script sends in the X-Integration-Key header. Leave empty to switch the endpoint off.
TICKET_WEBHOOK_KEY=

# ---- File storage (production: s3) ----
# STORAGE_BACKEND=s3 keeps files in a private bucket; the API hands the browser a short-lived signed link
# so downloads come straight from the bucket instead of through the API.
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_ENDPOINT_URL=https://fly.storage.tigris.dev
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_URL_EXPIRE_SECONDS=300

# ---- Performance ----
# DB_POOL_SIZE=10            # connections kept open per worker process
# DB_MAX_OVERFLOW=20         # extra connections allowed during a burst
# DASHBOARD_CACHE_SECONDS=30 # shared cache for the dashboard roll-ups and admin store lists (0 = off); any write clears it
# WEB_CONCURRENCY=2          # uvicorn workers (Fly sets this in fly.toml)
