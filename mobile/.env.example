# Copy to .env (not committed). EXPO_PUBLIC_* values are compiled into the app, so never put secrets here.

# The API. Release builds REQUIRE https. For local development use your computer's LAN address
# (a physical phone) or http://10.0.2.2:8000/api/v1 (Android emulator), in a development build.
EXPO_PUBLIC_API_URL=https://api.example.com/api/v1

# Shown on the sign-in and account screens, and used in the Play Store listing.
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
EXPO_PUBLIC_SUPPORT_PHONE=+910000000000
